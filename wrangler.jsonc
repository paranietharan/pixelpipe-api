{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pixelpipe-api",
	"main": "src/entry.py",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"python_workers"
	],
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "pixelpipe-images"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pixelpipe-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"env": {
		"dev": {
			"name": "pixelpipe-api-dev",
			"r2_buckets": [
				{
					"binding": "IMAGES_BUCKET",
					"bucket_name": "pixelpipe-images-dev"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "pixelpipe-db-dev",
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}